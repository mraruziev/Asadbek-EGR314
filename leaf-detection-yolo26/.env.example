# Roboflow PlantDoc export.
# Roboflow public exports still require a personal API key.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=plantdoc
ROBOFLOW_PROJECT=plantdoc
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=yolov8

# Kaggle PlantVillage export.
# Either install kaggle.json under ~/.kaggle or set these.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=emmarex/plantdisease

# Runtime defaults.
LEAF_AI_DEVICE=0
LEAF_AI_SOURCE=0
